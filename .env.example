# feishu-wiki-sync 环境配置
# 复制为 .env 填入真实值；.env 已被 gitignore，不会提交到公开仓库

# ---------- 飞书应用接入（必填）----------
# 飞书开放平台 https://open.feishu.cn 自建应用的凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 同步目标（必填）----------
# Wiki 空间 ID（python3 feishu_wiki_sync.py list-spaces 查询）
FEISHU_SPACE=0000000000000000
# 起始节点 token（可选，空=从空间根节点全量遍历；
# 从任一 wiki 页面 URL https://*.feishu.cn/wiki/<token> 取）
FEISHU_ROOT=

# ---------- 本地输出（必填）----------
# 同步输出目录。作为 LLM Wiki 源层时指向 wiki 的 raw/ 目录
SYNC_OUT=~/wiki/raw
# 是否下载图片（true/false，默认 true）
SYNC_DOWNLOAD_IMAGES=true
# 跳过 bitable/sheet 表格类文档（对知识图谱价值低）
SYNC_SKIP_TABLES=true

# ---------- 仓库信息（信息性记录）----------
# 工具仓库（本仓库）
GITHUB_REPO=https://github.com/radial-hks/feishu-wiki-sync
# 知识库内容仓库（本地 git，不推送）
WIKI_LOCAL_REPO=~/wiki
